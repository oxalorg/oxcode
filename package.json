{
  "name": "oxcode",
  "version": "0.1.0",
  "description": "oxcode: an opinionated coding-agent harness built on pi (pi.dev)",
  "type": "module",
  "license": "MIT",
  "author": "Mitesh Shah",
  "keywords": [
    "pi-package",
    "coding-agent",
    "harness"
  ],
  "bin": {
    "oxcode": "bin/oxcode.js"
  },
  "files": [
    "bin",
    "extensions",
    "skills",
    "prompts",
    "themes",
    "harness",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "start": "node bin/oxcode.js",
    "check": "tsc --noEmit",
    "doctor": "node bin/oxcode.js --oxcode-doctor"
  }
}
